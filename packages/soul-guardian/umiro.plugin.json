{
  "schemaVersion": 0,
  "id": "soul-guardian",
  "version": "0.2.0",
  "coreApi": "0",
  "entry": "./dist/src/index.js",
  "permissions": {
    "capabilities": ["soul_guardian.status", "soul_guardian.check", "soul_guardian.history", "soul_guardian.approve", "soul_guardian.restore", "discord.message.write"],
    "visibility": { "kind": "all" },
    "instructionAuthority": "none"
  },
  "namespace": "soul-guardian",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspacePath", "targets", "schedule"],
    "properties": {
      "workspacePath": { "type": "string", "minLength": 1, "description": "Umiro workspace root; supplied automatically by the installer." },
      "schedule": { "type": "string", "minLength": 1, "description": "Cron expression for deterministic integrity checks." },
      "timezone": { "type": "string", "minLength": 1, "description": "Optional IANA timezone for the check schedule." },
      "channelId": { "type": "string", "pattern": "^[0-9]{2,32}$", "description": "Optional Discord channel or thread ID for deduplicated alerts." },
      "targets": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode"],
          "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Complete file path relative to the workspace." }, "mode": { "enum": ["restore", "alert", "ignore"], "description": "restore reverts drift, alert only reports it, and ignore skips the file." } }
        }
      }
    }
  },
  "contributes": {
    "tools": ["soul_guardian_status", "soul_guardian_check", "soul_guardian_history", "soul_guardian_approve", "soul_guardian_restore"],
    "jobs": ["soul-guardian.check"],
    "commands": ["soul-guardian"]
  }
}
