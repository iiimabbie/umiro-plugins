{
  "schemaVersion": 0,
  "id": "intent-analyzer",
  "version": "0.1.0",
  "coreApi": "0",
  "entry": "./dist/src/index.js",
  "permissions": {
    "capabilities": [],
    "visibility": { "kind": "all" },
    "instructionAuthority": "none"
  },
  "namespace": "intent-analyzer",
  "optionalSecrets": ["UMIRO_INTENT_API_KEY"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "protocol": { "type": "string", "enum": ["openai-chat-completions"] },
      "baseUrl": { "type": "string", "minLength": 1 },
      "model": { "type": "string", "minLength": 1 },
      "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
      "maxInputCharacters": { "type": "integer", "minimum": 1, "maximum": 100000 },
      "maxResponseBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 },
      "responseFormat": { "type": "string", "enum": ["prompt-only", "json-object"] }
    }
  },
  "contributes": { "contextProviders": ["intent.analysis"] }
}
